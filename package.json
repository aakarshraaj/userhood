{
  "name": "userhood",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "generate:site": "node scripts/generate-site-files.mjs",
    "build": "npm run generate:site && npm run build:client && npm run build:prerender && node scripts/prerender.mjs && npm run validate:site",
    "build:client": "vite build",
    "build:prerender": "vite build --ssr src/prerender.tsx --outDir .prerender --emptyOutDir",
    "validate:site": "node scripts/validate-site.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "test": "npm run check",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^8.2.2"
  }
}
