{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:client && npm run build:prerender && node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:prerender": "vite build --ssr src/prerender.tsx --outDir .prerender --emptyOutDir",
